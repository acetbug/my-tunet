{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Optimal Release Binary",
            "command": "cargo",
            "args": [
                "build",
                "--release"
            ],
            "options": {
                "env": {
                    "RUSTFLAGS": "-C target-cpu=native"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}